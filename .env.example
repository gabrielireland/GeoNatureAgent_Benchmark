# Environment variables read by the GeoNatureAgent API and harness.
# Copy this file to `.env` (gitignored) and set the values you need.
#
# The file is organised by replication scenario:
#   1. Required for any run
#   2. Agent runtime (have working defaults)
#   3. Admin endpoints (optional)
#   4. Google Cloud — fetching layer data from GCS instead of the local filesystem
#   5. Google Cloud — Murcia erosion endpoint (api/endpoints/erosion.py)
#   6. Google Cloud — harness uploads results to GCS
#   7. Vertex AI — only when evaluating models via Vertex MaaS
#
# A local-only replication (single-machine, Anthropic-only) needs only sections 1-2.

# ═══════════════════════════════════════════════════════════════════════════
# 1. REQUIRED
# ═══════════════════════════════════════════════════════════════════════════

# Anthropic API key. The agent calls Claude as the underlying LLM and the
# harness uses it for the Claude experiments.
ANTHROPIC_API_KEY=sk-ant-...

# ═══════════════════════════════════════════════════════════════════════════
# 2. AGENT RUNTIME — have working defaults; override only if needed
# ═══════════════════════════════════════════════════════════════════════════

# "true"  → API reads layers from the local filesystem (api/data/).
# "false" → API expects signed-URL access to cloud storage (production).
# The open-source default is local.
LOCAL_DEV_MODE=true

# System prompt version. v3 is the evaluated production prompt.
# v1 and v2 are kept for provenance but not loaded by current code.
AGENT_PROMPT_VERSION=v3

# LLM model id for the agent. Defaults to claude-sonnet-4-20250514.
# AGENT_MODEL_ID=claude-sonnet-4-20250514

# Parallel tool execution where the tool-call graph has no data dependencies.
# Set to "false" to force sequential execution.
# AGENT_PARALLEL_TOOLS=true

# Directory for event JSONL logs. Created on first write.
# AGENT_LOG_DIR=./logs

# Directory where generate_chart writes PNG charts in LOCAL_DEV_MODE.
# Defaults to a temp dir (<system-tmp>/geonature_charts).
# CHART_OUTPUT_DIR=

# Port the FastAPI service listens on inside the container.
# PORT=8080

# ═══════════════════════════════════════════════════════════════════════════
# 3. ADMIN ENDPOINTS — optional
# ═══════════════════════════════════════════════════════════════════════════

# Bearer token guarding /admin/* endpoints. Leave unset to disable.
# ADMIN_TOKEN=

# ═══════════════════════════════════════════════════════════════════════════
# 4. GCS LAYER STORE — only if you replace local files with cloud reads
# ═══════════════════════════════════════════════════════════════════════════
# Leave blank for fully local operation (the default).

# GCP_PROJECT=
# GCP_REGION=europe-southwest1
# BUCKET_TILES=

# GCP project used to mint signed URLs for cloud-hosted COGs (read by the
# erosion tool executor). Distinct from GCP_PROJECT only because of how the
# Google Cloud SDK resolves credentials.
# GOOGLE_CLOUD_PROJECT=

# ═══════════════════════════════════════════════════════════════════════════
# 5. MURCIA EROSION ENDPOINT — optional, only used by api/endpoints/erosion.py
# ═══════════════════════════════════════════════════════════════════════════
# Defaults point at the public bucket used during the paper's runs.

# PARQUET_BUCKET=geonatureagent_benchmark
# PARQUET_BLOB=data/murcia/indices/murcia_zonal_stats.parquet

# ═══════════════════════════════════════════════════════════════════════════
# 6. HARNESS RESULTS UPLOAD — only if you want results streamed to GCS
# ═══════════════════════════════════════════════════════════════════════════
# Leave blank to keep results local under the harness --output-dir.

# Destination bucket for results.jsonl and _batch_summary.json.
# GCS_BUCKET=

# Prefix within the bucket (e.g., "GeoNatureAgent/experiments/run_20260515").
# Cloud Build sets this automatically per build; set manually for local runs.
# GCS_OUTPUT_PREFIX=

# ═══════════════════════════════════════════════════════════════════════════
# 7. VERTEX AI — only when evaluating Vertex MaaS models (Gemini, Llama, etc.)
# ═══════════════════════════════════════════════════════════════════════════
# Required for any experiment YAML whose model id begins with vertex_ai/.

# VERTEXAI_PROJECT=
# VERTEXAI_LOCATION=us-central1
